{
  "name": "classybling-server",
  "version": "1.0.0",
  "description": "Backend API, TikTok scraper, and AI vision extraction service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "scrape": "ts-node src/scripts/runScraper.ts",
    "crawl-all": "ts-node src/scripts/crawlAllClassyBling.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.50.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
